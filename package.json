{
  "name": "cue-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Cue core + GridWhisper (F1) + TPlus (launches)",
  "type": "module",
  "license": "MIT",
  "author": "datadr1ven",
  "repository": {
    "type": "git",
    "url": "https://github.com/datadr1ven/cue.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "replay": "node packages/cue/bin/replay.js",
    "worker": "npm run worker -w gridwhisper --",
    "worker:live:log": "npm run worker:live:log -w gridwhisper",
    "worker:live": "npm run worker:live -w gridwhisper",
    "worker:live:http": "npm run worker:live:http -w gridwhisper",
    "worker:local:log": "npm run worker:local:log -w gridwhisper",
    "worker:local:http": "npm run worker:local:http -w gridwhisper",
    "capture": "npm run capture -w gridwhisper --",
    "capture:local": "npm run capture:local -w gridwhisper --",
    "download": "npm run download -w gridwhisper --",
    "bot": "npm run bot -w gridwhisper",
    "publish": "npm run publish -w gridwhisper --",
    "starship:ops": "npm run starship:ops -w tplus --",
    "starship:bot": "npm run starship:bot -w tplus --",
    "webcast:schedule": "npm run webcast:schedule -w tplus --",
    "webcast:live": "npm run webcast:live -w tplus --",
    "webcast:listen": "npm run webcast:listen -w tplus --",
    "smoke:webcast": "npm run smoke:webcast -w tplus",
    "validate:missions": "npm run validate:missions -w tplus --",
    "smoke:tplus": "npm run smoke -w tplus",
    "smoke:gridwhisper": "npm run smoke -w gridwhisper",
    "smoke:inbox": "npm run smoke:inbox -w gridwhisper",
    "cf:deploy:tplus": "npm run cf:deploy -w tplus --",
    "cf:deploy:gridwhisper": "npm run cf:deploy -w gridwhisper --",
    "cf:dev:tplus": "npm run cf:dev -w tplus --",
    "cf:dev:gridwhisper": "npm run cf:dev -w gridwhisper --"
  },
  "engines": {
    "node": ">=18"
  }
}
