{
  "name": "cue",
  "version": "0.1.0",
  "description": "Real-time sparse event alerts from live streams (F1 domain included)",
  "type": "module",
  "license": "MIT",
  "author": "datadr1ven",
  "repository": {
    "type": "git",
    "url": "https://github.com/datadr1ven/cue.git"
  },
  "bugs": {
    "url": "https://github.com/datadr1ven/cue/issues"
  },
  "homepage": "https://github.com/datadr1ven/cue#readme",
  "keywords": [
    "alerts",
    "realtime",
    "mqtt",
    "telegram",
    "f1",
    "openf1",
    "events"
  ],
  "bin": {
    "cue-replay": "./bin/replay.js",
    "cue-worker": "./bin/worker.js",
    "cue-bot": "./bin/bot.js",
    "cue-publish": "./bin/publish-ndjson.js"
  },
  "scripts": {
    "replay": "node bin/replay.js",
    "worker": "node bin/worker.js",
    "worker:live:log": "MQTT_SOURCE=live DELIVERY_MODE=log node bin/worker.js",
    "worker:live": "MQTT_SOURCE=live DELIVERY_MODE=telegram node bin/worker.js",
    "worker:live:http": "MQTT_SOURCE=live DELIVERY_MODE=http node bin/worker.js",
    "worker:local:log": "MQTT_SOURCE=local DELIVERY_MODE=log node bin/worker.js",
    "worker:local:http": "MQTT_SOURCE=local DELIVERY_MODE=http node bin/worker.js",
    "capture": "MQTT_SOURCE=live node bin/capture.js",
    "capture:local": "MQTT_SOURCE=local node bin/capture.js",
    "download": "node bin/download.js",
    "bot": "node bin/bot.js",
    "publish": "node bin/publish-ndjson.js",
    "starship:ops": "node bin/starship-ops.js",
    "starship:bot": "node bin/starship-bot.js",
    "webcast:ocr-clock": ".venv-webcast/bin/python src/webcast/ocr_clock.py",
    "webcast:schedule": "node bin/webcast-schedule.js",
    "webcast:live": "node bin/webcast-live.js",
    "webcast:listen": "node bin/webcast-listen.js",
    "smoke:webcast": "node bin/smoke-webcast.js",
    "validate:missions": "node bin/validate-mission.js",
    "smoke:tplus": "node bin/smoke-tplus.js",
    "smoke:gridwhisper": "node bin/smoke-gridwhisper.js",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:tplus": "wrangler deploy",
    "cf:deploy:gridwhisper": "wrangler deploy -c wrangler.gridwhisper.toml",
    "cf:dev": "wrangler dev",
    "cf:dev:gridwhisper": "wrangler dev -c wrangler.gridwhisper.toml"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "byline": "^5.0.0",
    "dotenv": "^17.3.1",
    "mqtt": "^5.15.0",
    "telegraf": "^4.16.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
