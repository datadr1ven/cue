# Copy to .env and fill in:
#   cp .env.example .env

# F1TV subscription JWT (required for fuller livetiming streams).
# Same token you used with Cue's capture:signalr (F1_TOKEN / F1_SUBSCRIPTION_TOKEN).
F1_TOKEN=

# MQTT credentials — must match mqtt-config/mosquitto.passwd (default openf1/openf1)
OPENF1_MQTT_USERNAME=openf1
OPENF1_MQTT_PASSWORD=openf1
