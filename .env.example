# Telegram
TELEGRAM_TOKEN=
# Ops/admin ids (buttons, /note, /broadcast, /hype, /mission use)
# TELEGRAM_ADMIN_IDS=123456789
# Legacy alias if ADMIN_IDS unset:
# TELEGRAM_ALLOWLIST=123456789
# Anyone can /start and receive alerts (default true). Set false for private enroll.
# ENROLL_OPEN=true
# Optional seed subscribers (ids written into data/users.json without /start)
# SUBSCRIBER_IDS=

# Worker (required for bin/worker.js)
MQTT_SOURCE=local
DELIVERY_MODE=log
# GridWhisper race day → CF Worker fan-out (DELIVERY_MODE=http)
# DELIVERY_MODE=http
# DELIVER_URL=https://gridwhisper.scenicminddigital.workers.dev/deliver
# DELIVER_SECRET=
# Tag Telegram alerts (replay safety). Unset + MQTT_SOURCE=local → "🧪 REPLAY"
# ALERT_TAG=🧪 REPLAY
# ALERT_TAG=off

# OpenF1 live MQTT (MQTT_SOURCE=live)
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Local MQTT broker
MQTT_LOCAL_HOST=localhost
MQTT_LOCAL_PORT=1883

# Engine
# ENGINE_DOMAIN=f1
# ENGINE_MIN_SEVERITY=6
# ENGINE_MIN_SEVERITY=5
# Force F1 session kind (auto if unset):
#   practice | qualifying | sprint_qualifying | sprint | race
# Aliases: fp, quali, shootout, sq
# ENGINE_SESSION_KIND=qualifying
# ENGINE_SESSION_KIND=practice

# TPlus / Starship bot
# STARSHIP_MISSION=13
# STARSHIP_SCRIPT=missions/flights/starship-flight-13-script.json
# DELIVERY_MODE=telegram
