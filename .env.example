# Copy to .env at the monorepo root (gitignored).
# Loaded by cue/config.js and by webcast bins (same root .env).

# ── Telegram (shared) ──────────────────────────────────────────────
TELEGRAM_TOKEN=
# Ops/admin ids (comma-separated). First id is used for webcast artifact mint.
# TELEGRAM_ADMIN_IDS=123456789
# Legacy alias if ADMIN_IDS unset:
# TELEGRAM_ALLOWLIST=123456789
# Anyone can /start (default true). Set false for private enroll.
# ENROLL_OPEN=true
# Optional seed subscribers (file store / local bots)
# SUBSCRIBER_IDS=
# USERS_FILE=data/users.json

# ── TPlus webcast:live / webcast:schedule → CF /suggest ─────────────
# Required unless --dry-run
# TPLUS_SUGGEST_URL=https://tplus.scenicminddigital.workers.dev/suggest
# TPLUS_SUGGEST_SECRET=
# Default fan-out mode if CLI omits --mode (test|ops). CLI wins when passed.
# TPLUS_MODE=test
# Optional: python for OCR/ASR (default: repo .venv-webcast/bin/python)
# WEBCAST_PYTHON=
# WEBCAST_WHISPER_MODEL=tiny

# ── GridWhisper MQTT worker (apps/gridwhisper) ──────────────────────
MQTT_SOURCE=local
DELIVERY_MODE=log
# Race day → CF Worker fan-out
# DELIVERY_MODE=http
# DELIVER_URL=https://gridwhisper.scenicminddigital.workers.dev/deliver
# DELIVER_SECRET=
# Tag Telegram alerts (replay safety). Unset + MQTT_SOURCE=local → "🧪 REPLAY"
# ALERT_TAG=🧪 REPLAY
# ALERT_TAG=off
# Online/offline banners when laptop worker starts/stops (default on)
# LIFECYCLE_BANNERS=off

# OpenF1 live MQTT (MQTT_SOURCE=live)
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Local MQTT broker
MQTT_LOCAL_HOST=localhost
MQTT_LOCAL_PORT=1883

# Engine (F1 / shared)
# ENGINE_DOMAIN=f1
# ENGINE_MIN_SEVERITY=6
# Force F1 session kind (auto if unset):
#   practice | qualifying | sprint_qualifying | sprint | race
# Aliases: fp, quali, shootout, sq
# ENGINE_SESSION_KIND=qualifying

# ── TPlus local Node bot (optional; CF Worker is the usual path) ───
# STARSHIP_MISSION=starlink-sl-15-23
# STARSHIP_SCRIPT=apps/tplus/missions/flights/starship-flight-13-script.json
