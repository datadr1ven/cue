# Telegram
TELEGRAM_TOKEN=
# Comma-separated numeric chat ids (delivery filter and /start enrollment)
TELEGRAM_ALLOWLIST=
# Optional seed subscribers written into data/users.json
# SUBSCRIBER_IDS=

# Worker (required for bin/worker.js)
MQTT_SOURCE=local
DELIVERY_MODE=log

# OpenF1 live MQTT (MQTT_SOURCE=live)
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Local MQTT broker
MQTT_LOCAL_HOST=localhost
MQTT_LOCAL_PORT=1883

# Engine
# ENGINE_DOMAIN=f1
# ENGINE_MIN_SEVERITY=6
# ENGINE_MIN_SEVERITY=5
